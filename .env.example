VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-only: never prefix these settings with VITE_.
# Use your deployed site URL in Vercel, e.g. https://placepms.example.com.
APP_URL=http://localhost:5173
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-or-service-role-key
# Optional override for the first-installation owner. Defaults to placewiseinfo@gmail.com.
PLACEPMS_ADMIN_EMAIL=placewiseinfo@gmail.com
BREVO_SMTP_USER=your-brevo-smtp-login
# The Brevo SMTP key, NOT your Brevo account password or API key.
BREVO_SMTP_PASSWORD=your-brevo-smtp-key
BREVO_SMTP_PORT=587
BREVO_FROM_EMAIL=verified-sender@example.com
BREVO_FROM_NAME=PlacePMS

# Optional provider OAuth apps. PAT/API-token connections do not require these.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
MIRO_CLIENT_ID=
MIRO_CLIENT_SECRET=

# Optional stable 32-byte key, base64 encoded, for the integration token vault.
# If omitted, a separate encryption key is derived from SUPABASE_SECRET_KEY.
# Keep the same value on local/preview/production when sharing a database.
INTEGRATION_ENCRYPTION_KEY=

# Optional AI idea planner. Without a key, domain-aware starter plans still work.
# Keep these settings server-only; never add a VITE_ prefix.
IDEA_PLANNER_API_KEY=
IDEA_PLANNER_MODEL=gpt-4.1-mini
IDEA_PLANNER_BASE_URL=https://api.openai.com/v1/
